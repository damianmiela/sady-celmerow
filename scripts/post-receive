#!/bin/bash
#
# post-receive — Git hook for auto-deploy
# Installed at: /opt/sady-celmerow-deploy.git/hooks/post-receive
#
set -e

# ============================================================
# CONFIGURATION
# ============================================================
APP_NAME="sady-celmerow"
REPO_DIR="/opt/${APP_NAME}-deploy.git"
APP_DIR="/srv/${APP_NAME}"
LOG_FILE="${APP_DIR}/deploy.log"
export DOCKER_BUILDKIT=1
export COMPOSE_DOCKER_CLI_BUILD=1

# ============================================================
# DEPLOY
# ============================================================
{
    echo ""
    echo "========================================"
    echo " DEPLOY START: $(date '+%Y-%m-%d %H:%M:%S')"
    echo "========================================"

    # Read the pushed ref
    while read oldrev newrev refname; do
        LAST_REF="$refname"
    done

    if [ "$LAST_REF" = "refs/heads/main" ] || [ "$LAST_REF" = "refs/heads/master" ]; then
        # 1. Checkout latest code into the working directory
        echo ">>> Checking out latest code to ${APP_DIR}..."
        git --work-tree="${APP_DIR}" --git-dir="${REPO_DIR}" checkout -f main

        # 2. Move to the app directory
        cd "${APP_DIR}"

        # 3. Build and restart container
        echo ">>> Building the new image (the site keeps running), then restarting..."
        docker compose build
        docker compose up -d --remove-orphans

        # 4. Clean up dangling images (saves disk)
        echo ">>> Cleaning up old Docker images..."
        docker image prune -f 2>/dev/null || true

        echo ""
        echo "========================================"
        echo " DEPLOY COMPLETE: $(date '+%Y-%m-%d %H:%M:%S')"
        echo " App: ${APP_NAME}"
        echo " URL: http://$(hostname -I | awk '{print $1}'):3003"
        echo "========================================"
    else
        echo ">>> Branch $LAST_REF ignored — only main/master deploys."
    fi

} 2>&1 | tee -a "${LOG_FILE}"
