#!/usr/bin/env bash
#
# post-receive — Git hook for auto-deploy
# Installed at: /opt/repos/sady-celmerow.git/hooks/post-receive
#
set -euo pipefail

# ============================================================
# CONFIGURATION
# ============================================================
APP_NAME="sady-celmerow"
REPO_DIR="/opt/repos/${APP_NAME}.git"
APP_DIR="/opt/apps/${APP_NAME}"
LOG_FILE="${APP_DIR}/deploy.log"

# ============================================================
# DEPLOY
# ============================================================
{
    echo ""
    echo "========================================"
    echo " DEPLOY START: $(date '+%Y-%m-%d %H:%M:%S')"
    echo "========================================"

    # 1. Checkout latest code into the working directory
    echo ">>> Checking out latest code to ${APP_DIR}..."
    git --work-tree="${APP_DIR}" --git-dir="${REPO_DIR}" checkout -f

    # 2. Move to the app directory
    cd "${APP_DIR}"

    # 3. Build and restart container
    echo ">>> Building and restarting Docker container..."
    docker compose down --remove-orphans 2>/dev/null || true
    docker compose up -d --build

    # 4. Clean up dangling images (optional, saves disk)
    echo ">>> Cleaning up old Docker images..."
    docker image prune -f 2>/dev/null || true

    echo ""
    echo "========================================"
    echo " DEPLOY COMPLETE: $(date '+%Y-%m-%d %H:%M:%S')"
    echo " App: ${APP_NAME}"
    echo " URL: http://$(hostname -I | awk '{print $1}'):3003"
    echo "========================================"

} 2>&1 | tee -a "${LOG_FILE}"
