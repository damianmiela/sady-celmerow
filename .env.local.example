# Gmail SMTP configuration for contact form
# 
# 1. Enable 2-Step Verification on your Google Account:
#    https://myaccount.google.com/signinoptions/two-step-verification
#
# 2. Generate an App Password:
#    https://myaccount.google.com/apppasswords
#    Select "Mail" and "Other (Custom name)" → name it e.g. "Sady Celmerow Website"
#
# 3. Copy the 16-character password below (without spaces)

GMAIL_USER=your.address@gmail.com
GMAIL_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx
CONTACT_RECIPIENT=your.address@gmail.com

# Cloudflare Turnstile (https://dash.cloudflare.com → Turnstile → Add widget)
# These are Cloudflare's test keys, which always pass: fine locally. On the server,
# use your own keys. The site key is public and baked into the build at build time;
# the secret key is server only, never commit real values.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
